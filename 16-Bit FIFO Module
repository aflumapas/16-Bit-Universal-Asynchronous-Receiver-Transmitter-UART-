`timescale 1ns / 1ps
module FIFO #(
    parameter DATA_WIDTH = 16,        // Width of the data bus
    parameter ADDR_WIDTH = 4          // Address width (determines depth: 2^ADDR_WIDTH)
)(
    input  wire clk,      // System clock
    input  wire rst_n,    // Asynchronous active-low reset
    input  wire wr_en,    // Write enable control signal
    input  wire rd_en,    // Read enable control signal
    input  wire [DATA_WIDTH-1:0]    data_in,  // Data input bus
    output reg  [DATA_WIDTH-1:0]    data_out, // Data output bus
    output wire full,     // High when FIFO is full
    output wire empty     // High when FIFO is empty
);
    
    // Calculate total depth of the FIFO based on address width
    localparam DEPTH = 1 << ADDR_WIDTH;
    
    // Internal RAM storage array
    reg [DATA_WIDTH-1:0] fifo_ram [0:DEPTH-1];
    
    // Pointers and counters
    reg [ADDR_WIDTH-1:0] wr_ptr;      // Write pointer address
    reg [ADDR_WIDTH-1:0] rd_ptr;      // Read pointer address
    reg [ADDR_WIDTH:0]   count;       // Tracks current number of items in FIFO
    
    // Control wires: works if enabled and not in an invalid state (full/empty)
    wire write_valid = wr_en && !full;
    wire read_valid  = rd_en && !empty;

    // Write Logic: Stores incoming data into RAM, advances wr_ptr
    always @(posedge clk or negedge rst_n) 
    begin
        if (!rst_n) 
        begin
            wr_ptr <= {ADDR_WIDTH{1'b0}}; // Reset write pointer to zero
        end 
        else if (write_valid) 
        begin
            fifo_ram[wr_ptr] <= data_in;  // Write data into memory
            wr_ptr <= wr_ptr + 1'b1;      // Increment write pointer (wraps automatically)
        end
    end

    // Read Logic: Gets data from RAM, advances rd_ptr
    always @(posedge clk or negedge rst_n) 
    begin
        if (!rst_n) 
        begin
            rd_ptr   <= {ADDR_WIDTH{1'b0}}; // Reset read pointer to zero
            data_out <= {DATA_WIDTH{1'b0}}; // Clear output data bus
        end 
        else if (read_valid) 
        begin
            data_out <= fifo_ram[rd_ptr];   // Read data from memory
            rd_ptr   <= rd_ptr + 1'b1;      // Increment read pointer (wraps automatically)
        end
    end

    // Counter Logic: Tracks exact number of elements stored in the FIFO
    always @(posedge clk or negedge rst_n) 
    begin
        if (!rst_n) 
        begin
            count <= {(ADDR_WIDTH+1){1'b0}}; // Reset count to zero
        end 
        else if (write_valid && !read_valid) 
        begin
            count <= count + 1'b1; // Only writing: increment occupancy count
        end 
        else if (!write_valid && read_valid) 
        begin
            count <= count - 1'b1; // Only reading: decrement occupancy count
        end
        // Note: If both write_valid and read_valid are active simultaneously 
        // (or both inactive), the count remains unchanged.
    end

    // Status Flags
    assign empty = (count == 0);          // Asserted when the FIFO contains 0 elements
    assign full  = (count == DEPTH);      // Asserted when the FIFO contains maximum elements

endmodule
