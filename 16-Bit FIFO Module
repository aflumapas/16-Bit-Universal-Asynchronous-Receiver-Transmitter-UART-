`timescale 1ns / 1ps


module FIFO #(
    parameter DATA_WIDTH = 16,        
    parameter ADDR_WIDTH = 4        
)(
    input  wire clk,      
    input  wire rst_n,    
    input  wire wr_en,    
    input  wire rd_en,    
    input  wire [DATA_WIDTH-1:0] data_in,  
    output reg  [DATA_WIDTH-1:0] data_out, 
    output wire full,     
    output wire empty
);
    
    localparam DEPTH = 1 << ADDR_WIDTH;
    reg [DATA_WIDTH-1:0] fifo_ram [0:DEPTH-1];
    reg [ADDR_WIDTH-1:0] wr_ptr;
    reg [ADDR_WIDTH-1:0] rd_ptr;
    reg [ADDR_WIDTH:0] count;
    wire write_valid = wr_en && !full;
    wire read_valid  = rd_en && !empty;

    // Write Logic
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) 
        begin
            wr_ptr <= {ADDR_WIDTH{1'b0}}; 
        end 
        
        else if (write_valid) 
        begin
            fifo_ram[wr_ptr] <= data_in;
            wr_ptr <= wr_ptr + 1'b1;
        end
    end

    // Read Logic
    always @(posedge clk or negedge rst_n) 
    begin
        if (!rst_n) 
        begin
            rd_ptr <= {ADDR_WIDTH{1'b0}};
            data_out <= {DATA_WIDTH{1'b0}};
        end 
        
        else if (read_valid) 
        begin
            data_out <= fifo_ram[rd_ptr];
            rd_ptr <= rd_ptr + 1'b1;
        end
    end

    // Counter Logic
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) 
        begin
            count <= {(ADDR_WIDTH+1){1'b0}};
        end 
        
        else if (write_valid && !read_valid) 
        begin
            count <= count + 1'b1; // Only writing: increment count
        end 
        
        else if (!write_valid && read_valid) 
        begin
            count <= count - 1'b1; // Only reading: decrement count
        end
        // If both write_valid and read_valid are true (or both false)
    end

    assign empty = (count == 0);
    assign full  = (count == DEPTH);

endmodule
