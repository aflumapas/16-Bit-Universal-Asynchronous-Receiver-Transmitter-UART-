`timescale 1ns / 1ps
module BAUDRATE #(
    parameter CLK_FREQ   = 50000000, // 50 MHz default system clock
    parameter BAUD_RATE  = 9600,     // Target baud rate 
    parameter OVERSAMPLE = 16        // 16x oversampling for RX; use 1 for TX
)(
    input  wire clk,       // System clock
    input  wire rst_n,     // Asynchronous active-low reset
    output reg  baud_tick  // Output baud tick pulse (active for 1 clock cycle)
);

    // Calculate the counter threshold based on system frequency, baud rate, and oversampling factor
    localparam integer FINAL_VALUE = (CLK_FREQ / (BAUD_RATE * OVERSAMPLE)) - 1;
    
    // Set the counter width to 16 bits to hold the timer value
    reg [15:0] counter;
  
    // Baud Generator Logic
    always @(posedge clk or negedge rst_n) 
    begin
        // If reset is LOW, set counter to 0 and force the output tick to 0
        if (!rst_n) 
        begin
            counter   <= 16'd0;
            baud_tick <= 1'b0;
        end 
        // Otherwise, check counter value on each clock edge
        else 
        begin
            // If counter is equal to FINAL_VALUE, reset counter to 0 and pulse tick to 1
            if (counter == FINAL_VALUE) 
            begin
                counter   <= 16'd0;
                baud_tick <= 1'b1; // Pulse high for one clock cycle
            end 
            // Otherwise, increment the 16-bit counter by 1 and keep tick low
            else 
            begin
                counter   <= counter + 1'b1;
                baud_tick <= 1'b0; 
            end
        end
    end

endmodule
