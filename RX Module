`timescale 1ns / 1ps
module RX(
    input  wire clk,      
    input  wire rst_n,      
    input  wire s_tick,     
    input  wire rx,         
    output reg    rx_done_tick, 
    output reg [7:0] dout        
    );
    
    localparam [1:0]
        STATE_IDLE  = 2'b00,
        STATE_START = 2'b01,
        STATE_DATA  = 2'b10,
        STATE_STOP  = 2'b11;

    reg [1:0] state_reg, state_next;
    reg [3:0] s_reg, s_next;       
    reg [2:0] n_reg, n_next;       
    reg [7:0] b_reg, b_next;
    reg rx_sync_1, rx_sync_2;
    
    // 1. Two-stage synchronizer for meta-stability protection on raw rx line
    always @(posedge clk or negedge rst_n) 
    begin
        if (!rst_n) begin
            rx_sync_1 <= 1'b1;
            rx_sync_2 <= 1'b1;
        end 
        else begin
            rx_sync_1 <= rx;
            rx_sync_2 <= rx_sync_1;
        end
    end
    
    // 2. State and register synchronization
    always @(posedge clk or negedge rst_n) 
    begin
        if (!rst_n) 
        begin
            state_reg <= STATE_IDLE;
            s_reg     <= 4'b0;
            n_reg     <= 3'b0;
            b_reg     <= 8'b0;
            dout      <= 8'b0;
        end 
        
        else 
        begin
            state_reg <= state_next;
            s_reg     <= s_next;
            n_reg     <= n_next;
            b_reg     <= b_next;
            if (rx_done_tick)
                dout  <= b_reg;
        end
    end
    
    // 3. Next-state logic and oversampling data path
    always @* 
    begin
        state_next   = state_reg;
        s_next       = s_reg;
        n_next       = n_reg;
        b_next       = b_reg;
        rx_done_tick = 1'b0;

        case (state_reg)
            STATE_IDLE: 
            begin
                // Detect falling edge (start bit)
                if (!rx_sync_2) 
                begin
                    state_next = STATE_START;
                    s_next     = 4'b0;
                end
            end
            
            STATE_START: 
            begin
                if (s_tick) 
                begin
                    // Sample at the midpoint of the start bit (tick 7)
                    if (s_reg == 4'd7) 
                    begin
                        if (!rx_sync_2) 
                        begin
                            state_next = STATE_DATA;
                            s_next     = 4'b0;
                            n_next     = 3'b0;
                        end
                        
                        else
                            state_next = STATE_IDLE; // False start glitch
                    end
                    
                    else begin
                        s_next = s_reg + 1'b1;
                    end
                end
            end
            
            STATE_DATA: 
            begin
                if (s_tick) 
                begin
                    if (s_reg == 4'd15) 
                    begin
                        s_next = 4'b0;
                        // Shift received bit into MSB (LSB first transmission)
                        b_next = {rx_sync_2, b_reg[7:1]};
                        
                        if (n_reg == 3'd7)
                            state_next = STATE_STOP;
                            
                        else
                            n_next = n_reg + 1'b1;
                    end
                    
                    else 
                    begin
                        s_next = s_reg + 1'b1;
                    end
                end
            end
            
            STATE_STOP: 
            begin
                if (s_tick) 
                begin
                    // Wait for stop bit duration
                    if (s_reg == 4'd15) 
                    begin
                        state_next   = STATE_IDLE;
                        rx_done_tick = 1'b1;
                    end
                    
                    else 
                    begin
                        s_next = s_reg + 1'b1;
                    end
                end
            end
            
            default: state_next = STATE_IDLE;
        endcase
    end

endmodule
